# Cópia de referência. No GitHub Actions estes valores NÃO ficam num arquivo:
# vão em Settings > Secrets and variables > Actions.
# Localmente: copie para .env e rode `set -a; . ./.env; set +a`.
# NUNCA versione o .env de verdade — ele tem o app_secret.

# ---- obrigatórios (Secrets) ----
AUXSOL_BASE_URL=https://eu.auxsolcloud.com/auxsol-api
AUXSOL_APP_ID=119348
AUXSOL_APP_SECRET=coloque-o-secret-aqui
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAA/messages?key=...&token=...

# ---- opcionais ----
# Sem a chave o card sai igual, só sem o parágrafo escrito pela IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Vazio = todas as usinas visíveis para a credencial. Preencha depois de rodar
# `python main.py listar-usinas`. (No Actions, isto vai em Variables, não Secrets.)
PLANT_IDS=

# NÃO usar: a API já informa a capacidade real (100, 75 e 75 kWp). Um valor
# manual errado sobrescreveria o certo e estragaria a avaliação.
CAPACIDADE_KWP=

# Deixe vazio: o esperado é sazonal, calculado mês a mês pela tabela
# FORMA_MENSAL no código. Preencher aqui força um valor fixo o ano inteiro.
KWH_POR_KWP_ESPERADO=

# Hora local a partir da qual o dia solar é considerado fechado e pode ser
# julgado. Antes disso o card sai como parcial, sem semáforo.
HORA_DIA_FECHADO=20

# Depuração
DRY_RUN=
DEBUG=
AUXSOL_LANG=pt_BR
