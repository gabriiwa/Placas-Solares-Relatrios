# Cópia de referência. No GitHub Actions estes valores NÃO ficam num arquivo:
# vão em Settings > Secrets and variables > Actions.
# Localmente: copie para .env e rode `set -a; . ./.env; set +a`.
# NUNCA versione o .env de verdade — ele tem o app_secret.

# ---- obrigatórios (Secrets) ----
AUXSOL_BASE_URL=https://www.auxsolcloud.com/prod-api
AUXSOL_APP_ID=119348
AUXSOL_APP_SECRET=coloque-o-secret-aqui
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAA/messages?key=...&token=...

# ---- opcionais ----
# Sem a chave o card sai igual, só sem o parágrafo escrito pela IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Vazio = todas as usinas visíveis para a credencial. Preencha depois de rodar
# `python main.py listar-usinas`. (No Actions, isto vai em Variables, não Secrets.)
PLANT_IDS=

# Capacidade instalada, caso a API não devolva. Casa por pedaço do nome.
CAPACIDADE_KWP=Tijucas=60,Bairro Novo=60,Makiolka=60

# Referência de "dia bom" em kWh por kWp instalado. 4,2 é um valor razoável
# para o Paraná/Santa Catarina; ajuste depois de ver alguns meses de dados.
KWH_POR_KWP_ESPERADO=4.2

# Depuração
DRY_RUN=
DEBUG=
AUXSOL_LANG=pt_BR
